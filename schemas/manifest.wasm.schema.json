{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit WASM Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "source", "capabilities", "config", "meta"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "mediaType": { "enum": ["article", "manga", "video", "audio", "rating", "image", "social"] },
    "source": { "const": "wasm" },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["feed", "playback"] },
      "contains": { "const": "feed" }
    },
    "config": {
      "type": "object",
      "required": ["channels", "wasm"],
      "properties": {
        "refreshInterval": { "type": "integer", "minimum": 60 },
        "userAgent": { "type": "string" },
        "defaultChannel": { "type": "string" },
        "executionMode": { "enum": ["wasm", "browser", "hybrid"] },
        "variables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/variableDef" },
          "description": "User-configurable plugin variables (schema only; values provided at runtime)"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "deprecated": true,
          "description": "Deprecated: use variables for schema; values are provided by user at runtime"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel" }
        },
        "wasm": {
          "type": "object",
          "properties": {
            "entry": { "type": "string", "default": "plugin.wasm" },
            "timeoutMs": { "type": "integer", "minimum": 1000 },
            "maxMemoryMB": { "type": "integer", "minimum": 4 }
          }
        },
        "browser": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "fallbackOn": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "playback": { "$ref": "playback.schema.json#/$defs/playbackConfig" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "logoText": { "type": "string" },
        "logoImageUrl": { "type": "string" },
        "marketCategory": { "type": "string" },
        "categoryTag": { "type": "string" },
        "official": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["id", "label", "route"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "route": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "status": { "enum": ["enabled", "disabled"], "default": "enabled" },
        "itemLimit": {
          "type": "integer",
          "minimum": 1,
          "deprecated": true,
          "description": "Deprecated: use features.feed.limit"
        },
        "features": { "$ref": "#/$defs/features" },
        "type": {
          "enum": ["feed", "search"],
          "deprecated": true,
          "description": "Deprecated: use features.feed and features.search"
        },
        "dynamic": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated: use features.pagination, features.search, or features.detail"
        }
      }
    },
    "features": { "$ref": "features.schema.json" },
    "variableDef": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "secret": { "type": "boolean", "default": true },
        "default": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
