{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit WASM Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "source", "capabilities", "config", "meta"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "mediaType": { "enum": ["article", "novel", "manga", "video", "audio", "rating", "image", "social"] },
    "source": { "const": "wasm" },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["feed", "playback"] },
      "contains": { "const": "feed" }
    },
    "config": {
      "type": "object",
      "required": ["channels", "wasm"],
      "properties": {
        "refreshInterval": { "type": "integer", "minimum": 60 },
        "userAgent": { "type": "string" },
        "defaultChannel": { "type": "string" },
        "executionMode": {
          "enum": ["wasm", "browser", "hybrid"],
          "default": "wasm",
          "description": "Primary fetch path. See schemas/browser-preview.md. wasm=host HTTP+WASM; browser=WebView extract; hybrid=WebView raw payload + WASM parse"
        },
        "variables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/variableDef" },
          "description": "User-configurable plugin variables (schema only; values provided at runtime)"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "deprecated": true,
          "description": "Deprecated: use variables for schema; values are provided by user at runtime"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel" }
        },
        "wasm": {
          "type": "object",
          "properties": {
            "entry": { "type": "string", "default": "plugin.wasm" },
            "timeoutMs": { "type": "integer", "minimum": 1000 },
            "maxMemoryMB": { "type": "integer", "minimum": 4 }
          }
        },
        "browser": {
          "$ref": "#/$defs/browserConfig",
          "description": "Optional WebView assistance. Omit when unused. See schemas/browser-preview.md"
        },
        "playback": { "$ref": "playback.schema.json#/$defs/playbackConfig" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "logoText": { "type": "string" },
        "logoImageUrl": { "type": "string" },
        "marketCategory": { "type": "string" },
        "categoryTag": { "type": "string" },
        "official": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["id", "label", "route"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "route": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "status": { "enum": ["enabled", "disabled"], "default": "enabled" },
        "itemLimit": {
          "type": "integer",
          "minimum": 1,
          "deprecated": true,
          "description": "Deprecated: use features.feed.limit"
        },
        "features": { "$ref": "#/$defs/features" },
        "type": {
          "enum": ["feed", "search"],
          "deprecated": true,
          "description": "Deprecated: use features.feed and features.search"
        },
        "dynamic": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated: use features.pagination, features.search, or features.detail"
        }
      }
    },
    "features": { "$ref": "features.schema.json" },
    "browserConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": ["session", "fetch", "extract"],
          "description": "session=pass CF/captcha then persist Cookie for HTTP; fetch=WebView returns raw HTML/JSON; extract=WebView returns FeedResult via bridge"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "true=always use browser path (skip initial WASM HTTP); official signed plugins only"
        },
        "fallbackOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["captcha", "http_403", "http_503", "empty_items", "timeout"]
          },
          "description": "Error tokens that trigger browser retry after WASM/host HTTP failure"
        },
        "persist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cookie", "userAgent"]
          },
          "description": "Variable keys written back after successful browser session (purpose=session)"
        },
        "origins": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed WebView navigation origins (e.g. https://www.example.com)"
        }
      }
    },
    "variableDef": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "secret": { "type": "boolean", "default": true },
        "default": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
