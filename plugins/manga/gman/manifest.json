{
  "id": "gman",
  "name": "G社漫画",
  "version": "1.0.0",
  "mediaType": "manga",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "gman_hots",
    "executionMode": "wasm",
    "playback": {
      "history": true,
      "progress": true,
      "mode": "manga",
      "limit": 200,
      "managedBy": "runtime"
    },
    "channels": [
      {
        "id": "gman_hots",
        "label": "热门漫画",
        "route": "/gman/list",
        "params": {
          "page": "1",
          "slug": "hots"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 36
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "chapters": {
            "route": "/gman/chapters/:id",
            "idParam": "id",
            "label": "话数",
            "itemLabel": "话",
            "persist": true,
            "limit": 500,
            "detail": {
              "route": "/gman/chapter/:chapterId",
              "idParam": "chapterId",
              "parentParam": "id",
              "persist": false
            }
          }
        }
      },
