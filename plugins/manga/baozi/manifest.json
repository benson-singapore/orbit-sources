  "id": "baozi",
  "name": "包子漫画",
  "version": "1.0.0",
  "mediaType": "manga",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "baozi_hot",
    "executionMode": "wasm",
    "playback": {
      "history": true,
      "progress": true,
      "mode": "manga",
      "limit": 200,
      "managedBy": "runtime"
    },
    "channels": [
      {
        "id": "baozi_hot",
        "label": "热门漫画",
        "route": "/baozi/list",
        "params": {
          "page": "1",
          "slug": "hots"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 36
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "chapters": {
            "route": "/baozi/chapters/:id",
            "idParam": "id",
            "label": "话数",
            "itemLabel": "话",
            "persist": true,
            "limit": 500,
            "detail": {
              "route": "/baozi/chapter/:chapterId",
              "idParam": "chapterId",
              "parentParam": "id",
              "persist": false
            }
          }
        }
