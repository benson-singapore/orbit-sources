{
  "id": "voronoi",
  "name": "Voronoi",
  "version": "1.0.1",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "latest",
    "executionMode": "wasm",
    "variables": {
      "creator": {
        "label": "关注创作者",
        "description": "默认关注的 Voronoi 创作者用户名（与 voronoiapp.com/creator/{username} 一致）。配置后「我的关注」频道生效；也可在频道 params 里单独指定 creator 或 uid。",
        "required": false,
        "secret": false
      }
    },
    "channels": [
      {
        "id": "latest",
        "label": "最新",
        "route": "/voronoi/list",
        "params": {
          "feed": "latest",
          "offset": "0"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 200
          },
          "pagination": {
            "style": "offset",
            "param": "offset",
            "default": "0",
            "sizeParam": "size",
            "defaultSize": 20
          },
          "detail": {
            "route": "/voronoi/detail/:id",
            "idParam": "id",
            "persist": true
          }
        }
      },
