{
  "id": "tmdb",
  "name": "TMDB",
  "version": "1.0.0",
  "mediaType": "rating",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "movie_popular",
    "executionMode": "wasm",
    "variables": {
      "apiKey": {
        "label": "TMDB API Key / Access Token",
        "description": "在 https://www.themoviedb.org/settings/api 获取：v3 API Key 或 Read Access Token（Bearer JWT，以 eyJ 开头）均可",
        "required": true,
        "secret": true
      },
      "language": {
        "label": "语言",
        "description": "API 返回语言，如 zh-CN、en-US",
        "required": false,
        "secret": false,
        "default": "zh-CN"
      },
      "watchRegion": {
        "label": "流媒体地区",
        "description": "Netflix / Disney+ 等筛选使用的地区代码，如 US、CN、HK",
        "required": false,
        "secret": false,
        "default": "US"
      },
      "recentSince": {
        "label": "近期榜单起始日期",
        "description": "「近期最佳」类频道只包含此日期之后上映/开播的内容，格式 YYYY-MM-DD",
        "required": false,
        "secret": false,
        "default": "2023-01-01"
      },
      "minVoteCount": {
        "label": "近期高分最低评分数",
        "description": "近期高分榜单要求的最少评分人数，避免样本过少的高分作品",
        "required": false,
        "secret": false,
        "default": "200"
      }
    },
    "channels": [
      {
        "id": "movie_popular",
        "label": "热门电影",
        "route": "/tmdb/list",
        "params": {
          "endpoint": "movie/popular",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": { "persist": true, "refresh": true, "limit": 100 },
          "pagination": { "style": "offset", "param": "page", "default": "1" },
          "detail": { "route": "/tmdb/detail/:id", "idParam": "id", "persist": true }
        }
      },
      {
        "id": "tv_popular",
