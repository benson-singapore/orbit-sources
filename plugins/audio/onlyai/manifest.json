{
  "id": "onlyai",
  "name": "OnlyAI.fm",
  "version": "1.0.0",
  "mediaType": "audio",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "latest",
    "executionMode": "wasm",
    "playback": {
      "history": true,
      "progress": true,
      "mode": "audio",
      "limit": 200,
      "managedBy": "runtime"
    },
    "channels": [
      {
        "id": "latest",
        "label": "最新发布",
        "route": "/onlyai/latest",
        "params": {
          "size": "120"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 160
          },
          "pagination": {
            "style": "cursor",
            "param": "size",
            "default": "120"
          }
        }
      },
      {
        "id": "live",
        "label": "直播热门",
        "route": "/onlyai/live",
        "params": {
          "size": "60"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          }
        }
      },
      {
        "id": "charts",
        "label": "榜单",
        "route": "/onlyai/charts",
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 30
          },
          "detail": {
            "route": "/onlyai/detail",
            "idParam": "url",
            "idFrom": "item.url",
            "persist": false
          }
        }
      },
      {
        "id": "genre-pop",
        "label": "Pop",
        "route": "/onlyai/genre",
        "params": {
          "genre": "Pop"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "pagination": {
            "style": "cursor",
            "param": "sessionId",
            "default": ""
          }
        }
      },
      {
