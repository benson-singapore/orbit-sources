{
  "id": "gequbao",
  "name": "歌曲宝",
  "version": "1.0.0",
  "mediaType": "audio",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "hot-music",
    "executionMode": "wasm",
    "variables": {
      "cookie": {
        "label": "gequbao Cookie",
        "description": "可选：手动提供 Cookie 可跳过验证。留空时由 Orbit 在 Cloudflare 拦截时弹出浏览器完成验证（含 cf_clearance，会过期）",
        "required": false,
        "secret": true
      },
      "userAgent": {
        "label": "User-Agent",
        "description": "可选：与浏览器中复制 Cookie 时使用的 User-Agent 保持一致；留空使用默认 Chrome UA",
        "required": false,
        "secret": false
      }
    },
    "browser": {
      "purpose": "session",
      "required": false,
      "fallbackOn": ["captcha", "http_403"],
      "persist": ["cookie", "userAgent"],
      "origins": ["https://www.gequbao.com"]
    },
    "channels": [
      {
        "id": "hot-music",
        "label": "热门推荐",
        "route": "/gequbao/channel",
        "params": {
          "url": "https://www.gequbao.com/hot-music",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 200
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "detail": {
            "route": "/gequbao/detail",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": false
          }
        }
      },
      {
        "id": "week-download",
        "label": "周排行",
        "route": "/gequbao/channel",
        "params": {
          "url": "https://www.gequbao.com/top/week-download",
          "page": "1"
        },
        "status": "enabled",
        "features": {
