  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "singapore",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "realtime",
        "label": "即时",
        "route": "/8world/list",
        "params": {
          "section": "realtime",
          "page": "0"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "0"
          },
          "detail": {
            "route": "/8world/detail/:id",
            "idParam": "id",
            "idFrom": "item.url",
            "persist": true
          }
        }
