{
  "id": "thepaper",
  "name": "澎湃新闻",
  "version": "1.0.0",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "hot",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "hot",
        "label": "澎湃热榜",
        "route": "/thepaper/sidebar",
        "params": {
          "section": "hotNews"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/thepaper/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
