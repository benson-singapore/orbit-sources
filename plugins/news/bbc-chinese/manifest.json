{
  "id": "bbc-chinese",
  "name": "BBC News 中文",
  "version": "1.0.0",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "china",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "world",
        "label": "国际",
        "route": "/bbc-chinese/list",
        "params": {
          "section": "world",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "detail": {
            "route": "/bbc-chinese/detail/:id",
            "idParam": "id",
            "persist": true
          }
        }
      },
