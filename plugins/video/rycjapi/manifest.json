{
  "id": "rycjapi",
  "name": "TV-如意资源",
  "version": "1.0.0",
  "mediaType": "video",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "latest",
    "executionMode": "wasm",
    "playback": {
      "history": true,
      "progress": true,
      "mode": "video",
      "limit": 200,
      "managedBy": "runtime"
    },
    "variables": {
      "apiURL": {
        "label": "资源站 API URL",
        "description": "苹果 CMS / 资源站开放接口地址，默认使用 TV-如意资源",
        "required": false,
        "secret": false,
        "default": "https://cj.rycjapi.com/api.php/provide/vod"
      },
      "siteName": {
        "label": "站点名称",
        "description": "用于显示标题，默认 TV-如意资源",
        "required": false,
        "secret": false,
        "default": "TV-如意资源"
      }
    },
    "channels": [
      {
        "id": "latest",
        "label": "最新更新",
        "route": "/rycjapi/list",
        "params": {
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 20
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "chapters": {
            "route": "/rycjapi/chapters/:id",
            "idParam": "id",
            "label": "选集",
            "itemLabel": "集",
            "persist": true,
            "limit": 500,
            "detail": {
              "route": "/rycjapi/episode/:chapterId",
              "idParam": "chapterId",
              "parentParam": "id",
              "persist": false
            }
          }
        }
      },
      {
