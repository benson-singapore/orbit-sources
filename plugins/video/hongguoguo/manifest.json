{
  "id": "hongguoguo",
  "name": "红果果短剧",
  "version": "1.0.0",
  "mediaType": "video",
  "source": "wasm",
  "capabilities": [
    "feed",
    "playback"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "jingxuan",
    "executionMode": "wasm",
    "playback": {
      "history": true,
      "progress": true,
      "mode": "video",
      "limit": 200,
      "managedBy": "runtime"
    },
    "variables": {
      "baseURL": {
        "label": "站点地址",
        "description": "红果果短剧网根地址",
        "required": false,
        "secret": false,
        "default": "https://www.hongguoguo.tv"
      }
    },
    "channels": [
      {
        "id": "jingxuan",
        "label": "精选短剧",
        "route": "/hongguoguo/list/:type",
        "params": {
          "type": "jingxuanduanju",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 48
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "chapters": {
            "route": "/hongguoguo/chapters/:id",
            "idParam": "id",
            "label": "选集",
            "itemLabel": "集",
            "persist": true,
            "limit": 500,
            "detail": {
              "route": "/hongguoguo/episode/:chapterId",
              "idParam": "chapterId",
              "parentParam": "id",
              "persist": false
            }
          }
        }
      },
