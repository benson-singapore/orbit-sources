{
  "id": "opennana",
  "name": "OpenNana Prompts",
  "version": "1.0.0",
  "mediaType": "image",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 1800,
    "defaultChannel": "image-all",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "image-all",
        "label": "图片 · 全部",
        "route": "/opennana/list",
        "params": {
          "page": "1",
          "media_type": "image"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "image-chatgpt",
        "label": "图片 · ChatGPT",
        "route": "/opennana/list",
        "params": {
          "page": "1",
          "media_type": "image",
          "model": "ChatGPT"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "image-grok",
