        "params": {
          "page": "1",
          "media_type": "image",
          "model": "Grok"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "image-nano-banana-pro",
