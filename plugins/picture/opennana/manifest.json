        "label": "视频 · 全部",
        "route": "/opennana/list",
        "params": {
          "page": "1",
          "media_type": "video"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
