        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 60
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "image-nano-banana-2",
        "label": "图片 · Nano Banana 2",
        "route": "/opennana/list",
        "params": {
          "page": "1",
          "media_type": "image",
