        }
      },
      {
        "id": "search",
        "label": "搜索",
        "route": "/opennana/list",
        "params": {
          "page": "1",
          "media_type": "image",
          "search": ""
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": false,
            "refresh": false,
            "limit": 60
          },
          "search": {
            "param": "search",
            "required": true
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "detail": {
            "route": "/opennana/detail/:slug",
            "idParam": "slug",
            "idFrom": "item.id",
            "persist": true
          }
        }
      }
    ],
    "wasm": {
      "entry": "plugin.wasm",
      "timeoutMs": 120000,
      "maxMemoryMB": 64
    }
  },
  "meta": {
    "description": "OpenNana AI 提示词画廊，浏览 ChatGPT / Grok / Nano Banana 等模型生成的图片与视频提示词。",
    "icon": "image",
    "color": "bg-pink-500",
    "logoText": "Na",
    "marketCategory": "photo",
    "categoryTag": "AI",
    "official": false
  }
