          "size": "20"
        },
        "status": "enabled",
        "features": {
          "pagination": { "style": "offset", "param": "page", "default": "1", "sizeParam": "size", "defaultSize": 20 },
          "feed": { "persist": true, "refresh": true, "limit": 20 }
