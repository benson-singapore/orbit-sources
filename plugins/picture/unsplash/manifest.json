    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "nature",
    "executionMode": "wasm",
    "variables": {
      "cookie": {
        "label": "Unsplash Cookie",
        "description": "浏览器登录 unsplash.com 后，从开发者工具 Network 复制请求 Cookie（含 un_sesh、uuid 等，会过期需定期更新）",
        "required": true,
        "secret": true
      }
    },
    "channels": [
