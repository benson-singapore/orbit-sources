  "id": "pixabay",
  "name": "Pixabay",
  "version": "1.0.0",
  "mediaType": "image",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "photo-nature",
    "executionMode": "wasm",
    "variables": {
      "apiKey": {
        "label": "Pixabay API Key",
        "description": "在 https://pixabay.com/api/docs/ 登录后获取，免费账户每分钟最多 100 次请求",
        "required": true,
        "secret": true
      },
      "lang": {
        "label": "搜索语言",
        "description": "API lang 参数，如 zh、en、ja、ko",
        "required": false,
        "secret": false,
        "default": "zh"
      },
      "safesearch": {
        "label": "安全搜索",
        "description": "仅返回适合全年龄的内容，true 或 false",
        "required": false,
        "secret": false,
        "default": "true"
      }
    },
