        "id": "editors-choice-photo",
        "label": "编辑精选 · 照片",
        "route": "/pixabay/images",
        "params": {
          "image_type": "photo",
          "editors_choice": "true",
          "order": "popular",
          "page": "1",
          "size": "50"
        },
        "status": "enabled",
        "features": {
          "pagination": { "style": "offset", "param": "page", "default": "1", "sizeParam": "size", "defaultSize": 50 },
