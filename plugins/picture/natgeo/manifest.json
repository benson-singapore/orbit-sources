{
  "id": "natgeo",
  "name": "National Geographic",
  "version": "1.1.0",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 900,
    "userAgent": "",
    "defaultChannel": "home",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "home",
        "label": "首页精选",
        "route": "/natgeo/:category",
        "params": {
          "category": "home",
          "size": "10"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "lastId",
            "param": "lastId",
            "default": "",
            "sizeParam": "size",
            "defaultSize": 10
          },
          "feed": {
            "persist": false,
            "refresh": true,
            "limit": 10
          }
        }
      },
