        }
      },
      {
        "id": "phone-hot",
        "label": "手机壁纸（热门）",
        "route": "/bing/phone",
        "params": {
          "order": "hot",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
