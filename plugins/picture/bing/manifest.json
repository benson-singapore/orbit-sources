          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      }
    ],
    "wasm": {
      "entry": "plugin.wasm",
      "timeoutMs": 120000,
      "maxMemoryMB": 64
    }
  },
  "meta": {
    "description": "Bing 每日精选高清壁纸，按最新/热门/归档/手机壁纸分类浏览，数据来源 bing.gifposter.com。",
    "icon": "image",
    "color": "bg-blue-500",
    "logoText": "Bing",
    "marketCategory": "wallpaper",
    "categoryTag": "WALLPAPER",
    "official": true
  }
}
