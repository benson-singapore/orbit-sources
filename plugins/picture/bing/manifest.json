          }
        }
      },
      {
        "id": "hot-desc-slide",
        "label": "热门壁纸（幻灯片）",
        "route": "/bing/list",
        "params": {
          "category": "hot",
          "sort": "desc",
          "layout": "slide",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "phone-new",
        "label": "手机壁纸（最新）",
        "route": "/bing/phone",
        "params": {
          "order": "new",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
