{
  "id": "bing",
  "name": "Bing Wallpaper",
  "version": "2.0.0",
  "mediaType": "image",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 86400,
    "defaultChannel": "new-desc-classic",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "new-desc-classic",
        "label": "最新壁纸",
        "route": "/bing/list",
        "params": {
          "category": "new",
          "sort": "desc",
          "layout": "classic",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "new-asc-classic",
        "label": "最新壁纸（升序）",
        "route": "/bing/list",
        "params": {
          "category": "new",
          "sort": "asc",
          "layout": "classic",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "new-desc-slide",
        "label": "最新壁纸（幻灯片）",
        "route": "/bing/list",
        "params": {
          "category": "new",
          "sort": "desc",
          "layout": "slide",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "hot-desc-classic",
        "label": "热门壁纸",
        "route": "/bing/list",
        "params": {
          "category": "hot",
          "sort": "desc",
          "layout": "classic",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
            "persist": true
          }
        }
      },
      {
        "id": "hot-asc-classic",
        "label": "热门壁纸（升序）",
        "route": "/bing/list",
        "params": {
          "category": "hot",
          "sort": "asc",
          "layout": "classic",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1"
          },
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          },
          "detail": {
            "route": "/bing/detail/:id",
            "idParam": "id",
            "idFrom": "item.id",
