{
  "id": "hellogithub",
  "name": "HelloGitHub",
  "version": "2.0.0",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 3600,
    "userAgent": "",
    "defaultChannel": "tags",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "tags",
        "label": "分类列表",
        "route": "/hellogithub/tags",
        "status": "disabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 100
          }
        }
      },
      {
        "id": "python-featured",
        "label": "Python",
