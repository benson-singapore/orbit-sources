{
  "id": "cnblogs",
  "name": "博客园",
  "version": "1.0.0",
  "mediaType": "article",
  "source": "wasm",
  "capabilities": [
    "feed"
  ],
  "config": {
    "refreshInterval": 1800,
    "userAgent": "",
    "defaultChannel": "home",
    "executionMode": "wasm",
    "channels": [
      {
        "id": "home",
        "label": "首页",
        "route": "/cnblogs/list",
        "params": {
          "section": "home",
          "page": "1"
        },
        "status": "enabled",
        "features": {
          "feed": {
            "persist": true,
            "refresh": true,
            "limit": 200
          },
          "pagination": {
            "style": "offset",
            "param": "page",
            "default": "1",
            "sizeParam": "size",
            "defaultSize": 20
          },
          "detail": {
            "route": "/cnblogs/detail/:id",
            "idParam": "id",
            "idFrom": "item.url",
            "persist": true
          }
        }
      },
